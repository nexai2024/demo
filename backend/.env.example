# Copy to backend/.env (never commit .env).
# On Vercel: set the same variables in Project Settings -> Environment Variables
# (Project Root Directory must be `backend`; entrypoint is app.py, see pyproject.toml).
# Generate strong random keys with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ENV=production
JWT_SECRET=
JWT_SECRET_PREVIOUS=
VAULT_MASTER_KEY=
VAULT_MASTER_KEY_PREVIOUS=
CORS_ORIGINS=https://app.example.com
WEBHOOK_CRON_SECRET=

# Identity, user administration, and billing (Clerk)
# Frontend (Vercel frontend project): VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
# API / worker: set AUTH_PROVIDER=clerk for the fresh Clerk launch.
AUTH_PROVIDER=clerk
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUTHORIZED_PARTIES=https://app.example.com,http://localhost:3000,http://127.0.0.1:3000
CLERK_ADMIN_EMAILS=admin@example.com
# In Clerk Dashboard: enable Billing, create matching User plans
# (free/starter/pro) and Organization plans (pro/team/business), then point
# a webhook at https://api.example.com/api/webhooks/clerk for user.*,
# organization*, subscription*, subscriptionItem.*, paymentAttempt.* events.

# Credential & captured browser state expiry
CREDENTIAL_TTL_DAYS=30
STORAGE_STATE_TTL_HOURS=12

# Outbound network policy (optional comma-separated port allowlist; default 80,443,8080,8443)
OUTBOUND_ALLOWED_PORTS=

# AI (OpenAI is the only provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# Browser recording
BROWSERLESS_API_KEY=
BROWSERLESS_WS_URL=wss://production-sfo.browserless.io
MONTHLY_RECORDING_LIMIT=20

# Data store (MongoDB is required in production for atomic leases, quotas, and releases)
MONGO_URL=
DB_NAME=appshowcase

# Durable shared object storage (S3 / Cloudflare R2 / MinIO — required in production)
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PREFIX=appshowcase

# Durable job worker (set EMBEDDED_WORKER=false on API replicas and run `python worker.py` separately)
EMBEDDED_WORKER=false
JOB_LEASE_SECONDS=120
JOB_MAX_ATTEMPTS=2
