# Copy to backend/.env (never commit .env). Generate secrets with: python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_ENV=production
JWT_SECRET=
CORS_ORIGINS=https://app.example.com
WEBHOOK_CRON_SECRET=

# AI (OpenAI is the only provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# Recording
BROWSERLESS_API_KEY=
MONTHLY_RECORDING_LIMIT=20

# Data store: set MONGO_URL for production (indexes are created on startup).
# Leave empty to use NoCodeBackend (small deployments only).
MONGO_URL=
DB_NAME=flowcast
NCB_INSTANCE=
NCB_SECRET_KEY=
NCB_BASE_URL=
NCB_AUTH_API_URL=
